# ====================================================================
# 企业级 AI Agent 智能助手平台 - 全局配置
# 使用方法：复制本文件为 .env，填入真实密钥即可
# ====================================================================

# ---- LLM 对话模型（DeepSeek）----
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Embedding 向量模型（智谱 embedding-2，1024维）----
# 说明：DeepSeek 官方未提供 Embedding API，采用智谱 embedding-2，维度1024，与PG表结构 vector(1024) 匹配
ZHIPU_API_KEY=your-zhipu-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-2
EMBEDDING_DIMENSION=1024

# ---- Tavily 搜索工具（可选，MCP远程工具示例用）----
TAVILY_API_KEY=tvly-your-tavily-key

# ---- PostgreSQL + pgvector 配置（对话记忆 + 业务存储）----
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=ai_agent

# ---- Milvus 配置（静态知识库 RAG 检索）----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=knowledge_base

# ---- LangSmith 全链路追踪（可选）----
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-agent-prod
LANGCHAIN_TRACING_V2=true

# ---- Agent 运行参数 ----
MAX_REACT_ITERATIONS=10          # ReAct最大循环次数（防死循环）
MAX_HISTORY_TOKENS=4000          # 历史记忆最大token阈值（超阈值触发压缩）
SHORT_MEMORY_ROUNDS=3            # 短期记忆保留轮数
RAG_TOP_K=5                      # RAG向量召回数量
RERANK_TOP_K=3                   # 精排后保留数量
SIMILARITY_THRESHOLD=0.65        # 向量召回相似度阈值
SESSION_EXPIRE_HOURS=72          # 会话过期时间

# ---- 服务参数 ----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
