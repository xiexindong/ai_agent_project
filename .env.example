# ====================================================================
# 企业级 AI Agent 智能助手平台 - 全局配置
# 使用方法：复制本文件为 .env，填入真实密钥即可
# ====================================================================

# ---- LLM 对话模型（DeepSeek）----
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Embedding 向量模型（智谱 embedding-2，1024维）----
# 说明：DeepSeek 官方未提供 Embedding API，采用智谱 embedding-2，维度1024，与PG表结构 vector(1024) 匹配
ZHIPU_API_KEY=your-zhipu-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-2
EMBEDDING_DIMENSION=1024

# ---- Tavily 搜索工具（可选，MCP远程工具示例用）----
TAVILY_API_KEY=tvly-your-tavily-key

# ---- PostgreSQL + pgvector 配置（对话记忆 + 业务存储）----
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=ai_agent

# ---- Milvus 配置（静态知识库 RAG 检索）----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=knowledge_base

# ---- MySQL 配置（企业内部数据：用户/部门/角色/权限/审计/用量）----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_agent_enterprise

# ---- 企业级开关 ----
RBAC_ENABLED=true            # true 走 MySQL 权限；false 关闭权限走本地演示 Key
RBAC_FAIL_CLOSED=true        # true 权限库不可用则拒绝服务（生产必开）；false 才降级放行
RBAC_CACHE_TTL=60            # 权限缓存秒数，改权限最多延迟这么久生效
KB_ACL_ENABLED=true          # 知识库按授权过滤
MASK_ENABLED=true            # 字段脱敏

# ---- 数据生命周期（跨库治理）----
OFFBOARD_ARCHIVE_ENABLED=true  # 离职员工会话自动归档
DATA_RETENTION_DAYS=180        # 归档后保留天数，到期清理
RECONCILE_INTERVAL_HOURS=24    # 跨库对账周期（小时），0 表示不跑后台对账
SESSION_HOT_DAYS=90            # PG 只保留最近 90 天的热会话，更老的导出归档
ARCHIVE_ENABLED=true           # 归档开关：false = 只清理不导出（会丢证据，慎用）
ARCHIVE_DIR=archives           # 归档目录，将来换 OSS/S3 只需改 archiver 一处
MYSQL_READONLY_USER=           # AI 只读账号（留空则复用主账号，靠代码层闸门兜底）
MYSQL_READONLY_PASSWORD=

# ---- LLM 稳定性 ----
LLM_TIMEOUT_SECONDS=30       # 单次 LLM 调用超时
LLM_MAX_ATTEMPTS=3           # 失败重试次数（指数退避）
FALLBACK_MODEL=              # 备用模型，留空表示不降级（降级与熔断都要配了它才生效）
CB_FAILURE_THRESHOLD=5       # 熔断阈值：主模型连续失败几次后直接跳过它，不再白等超时
CB_RECOVERY_SECONDS=30       # 熔断冷却期：多久后放一个探针试探，成功才把流量切回主模型
TOOL_TIMEOUT_SECONDS=30      # 工具调用超时

# ---- MCP 技能网关（远程技能不直连 LLM）----
MCP_ENABLED=true             # false 则完全不纳管远程技能
MCP_LAZY_CONNECT=true        # 拉完工具目录就断开子进程，调用时再连
MCP_CATALOG_CACHE=data/mcp_catalog.json  # 工具目录落盘缓存，重启后免拉起所有 server
MCP_CONNECT_RETRY=2          # 单个 server 的连接重试次数
MCP_SERVERS_JSON=            # 多 server，如 [{"name":"finance-mcp","command":["python","-m","finance_server"]}]；留空用默认单 server

# ---- Tool-RAG 工具语义召回 ----
TOOL_RAG_ENABLED=true        # false 则退回「全部工具」模式
TOOL_RAG_TOP_K=5             # 每轮最多召回几个工具
TOOL_RAG_MIN_SCORE=0.25      # 相似度绝对下限（实测：正确候选 0.28~0.63，噪声 0.14~0.20）
TOOL_RAG_RELATIVE_RATIO=0.6  # 相对下限：候选分数需 ≥ 本轮最高分 × 0.6（跟第一名走，换模型不用重调）
MAX_TOOLS_PER_TURN=8         # 单轮工具名单硬上限（技能绑定 + 语义召回合计）

# ---- 服务安全 ----
CORS_ORIGINS=*               # 生产改为具体域名，逗号分隔

# ---- LangSmith 全链路追踪（可选）----
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-agent-prod
LANGCHAIN_TRACING_V2=true

# ---- Agent 运行参数 ----
MAX_REACT_ITERATIONS=10          # ReAct最大循环次数（防死循环）
MAX_HISTORY_TOKENS=4000          # 历史记忆最大token阈值（超阈值触发压缩）
SHORT_MEMORY_ROUNDS=3            # 短期记忆保留轮数
RAG_TOP_K=5                      # RAG向量召回数量
RERANK_TOP_K=3                   # 精排后保留数量
SIMILARITY_THRESHOLD=0.65        # 向量召回相似度阈值
SESSION_EXPIRE_HOURS=72          # 会话过期时间

# ---- 多模态（Vision 视觉模型，不配则自动降级为文本）----
VISION_ENABLED=false             # true 才真正调用视觉模型；false 图片降级成占位文本
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini
VISION_TEMPERATURE=0.2
VISION_MAX_TOKENS=2048
VISION_TIMEOUT_SECONDS=60
VISION_MAX_IMAGE_MB=5            # 单张图片上限，超过直接校验失败（不花冤枉钱）
VISION_MAX_IMAGES=4              # 一次最多带几张图（图片 token 很贵）
VISION_MAX_FILE_CHARS=8000       # 文件转文本后的截断长度

# ---- 多 Agent 团队 ----
MULTIAGENT_ENABLED=true
MULTIAGENT_MAX_WORKERS=4         # 并行执行子任务的线程数
MULTIAGENT_MAX_STEPS=3           # 单个 Agent 最多推理步数
MULTIAGENT_MAX_TOTAL_STEPS=30    # 一次运行的总步数预算（防多 Agent 循环叠加）
MULTIAGENT_TIMEOUT_SECONDS=120   # 一次运行的总超时
MULTIAGENT_REVIEW_ENABLED=true   # 是否让 reviewer 终审

# ---- 可选框架桥接（两个库不装也能跑，装了才切）----
RAG_BACKEND=native                  # native=自研Milvus+BGE精排 | llamaindex=独立索引（切过去旧库看不到）
MULTIAGENT_BACKEND=native           # native=自研Harness | crewai=角色扮演编排（需另配 litellm 模型）
LLAMAINDEX_PERSIST_DIR=storage/llamaindex
# 安装可选依赖：pip install -r requirements-extras.txt

# ---- 服务参数 ----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
